# Caddy configuration for the Telegram Mini App shop.
#
# Caddy obtains and renews a Let's Encrypt certificate automatically, which is
# what Telegram requires: Mini Apps only open over HTTPS with a valid cert.
#
# THIS FILE IS THE SOURCE OF TRUTH. Every deploy synchronises it to
# /etc/caddy/Caddyfile through deploy/sync-caddy.sh, which rewrites the site
# address to the server's domain, validates the result and only then installs
# it. Edit here and deploy; a change made directly on the server is overwritten
# by the next deploy that touches the config.
#
# It did not always work that way: the config used to be installed only by
# setup-server.sh, which runs once at provisioning. The `handle /uploads/*`
# block below sat committed but uninstalled for five deploys, and banner images
# came back as index.html with a 200.

ochkisk.shop {
	encode zstd gzip

	# --- API + bot webhook ---------------------------------------------------
	# Everything the backend owns is proxied to the Node process on localhost.
	# The API is never exposed directly to the internet.
	@backend path /api/* /health /telegram/*
	handle @backend {
		reverse_proxy 127.0.0.1:8080 {
			# Preserve the real client IP so the API's rate limiter works.
			header_up X-Real-IP {remote_host}
		}
	}

	# --- uploaded media ------------------------------------------------------
	# Served straight from disk, bypassing Node: these are static files, and
	# streaming them through the API would waste memory on the small VPS.
	#
	# The directory is under `shared`, NOT under a release: deploys prune old
	# releases, so media written there would vanish on the next deploy.
	handle /uploads/* {
		root * /srv/shop/shared
		file_server {
			# No directory listing: the file names are the only thing protecting
			# an upload from being enumerated.
			browse off
		}

		# Names are content-addressed random hex, so a given URL never changes
		# content and can be cached hard.
		header Cache-Control "public, max-age=31536000, immutable"
		# Uploads are user-supplied bytes. Even though the API sniffs magic bytes
		# before storing, never let a browser re-interpret the type.
		header X-Content-Type-Options "nosniff"
	}

	# --- Mini App static files -----------------------------------------------
	handle {
		root * /srv/shop/current/apps/miniapp/dist
		try_files {path} /index.html
		file_server

		# Hashed asset filenames can be cached forever.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# index.html must never be cached, or users get a stale app shell that
		# references deleted asset files after a deploy.
		@html path / /index.html
		header @html Cache-Control "no-cache, must-revalidate"
	}

	# --- security headers ----------------------------------------------------
	header {
		# Telegram embeds the Mini App in a WebView/iframe, so framing must NOT
		# be denied (no X-Frame-Options: DENY). Framing is restricted to
		# Telegram origins via frame-ancestors instead.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; frame-ancestors https://web.telegram.org https://*.telegram.org tg://; base-uri 'none'; object-src 'none'"

		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# Do not advertise the server software.
		-Server
	}

	log {
		output file /var/log/caddy/shop.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
