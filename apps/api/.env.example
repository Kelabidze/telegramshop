# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# Local SQLite database (path is relative to apps/api).
DATABASE_URL="file:./prisma/dev.db"

# Where uploaded banner and product media is stored (relative to apps/api).
# In production this MUST be outside the release directory — deploys prune old
# releases — which is why setup-server.sh points it at shared/uploads.
UPLOADS_DIR="./uploads"

# --- Telegram ---------------------------------------------------------------
# From @BotFather -> /newbot (or /token for an existing bot).
# This token is the signing key for initData. Treat it as a password.
TELEGRAM_BOT_TOKEN=""

# Secret for Telegram webhook verification. Any random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=""

# Public HTTPS origin of THIS api (used to register the webhook).
# With cloudflared this looks like https://something.trycloudflare.com
PUBLIC_API_URL=""

# Public HTTPS origin of the MINI APP. This is what the bot's buttons open.
# Leave empty only when the API and the app share one origin (production via
# Caddy); otherwise the buttons would open the API and show the user JSON.
PUBLIC_APP_URL=""

# --- Club channel -----------------------------------------------------------
# Membership in this channel activates the club tier (a 5% lower price).
# Either @publicname or a numeric -100... id. THE BOT MUST BE AN ADMINISTRATOR
# of the channel, otherwise getChatMember is refused and nobody gets the rate.
# Leave empty to disable the feature: everyone then pays the standard price.
CLUB_CHANNEL_ID=""

# Public invite link shown to users. Must point at the same channel as
# CLUB_CHANNEL_ID. Required together with it: a channel nobody is invited to
# join, or a link whose membership is never verified, is always a mistake.
CLUB_CHANNEL_URL=""

# How long a membership answer is cached, in seconds. Kept short so a user who
# just subscribed sees the club price almost immediately.
CLUB_MEMBERSHIP_TTL_SECONDS="60"

# --- Payments ---------------------------------------------------------------
# "stars"  -> Telegram Stars (XTR). No provider token needed.
# "none"   -> checkout creates orders but cannot charge (dev only).
PAYMENT_PROVIDER="stars"

# Only for real-money currencies via a payment provider (YooKassa, Stripe...).
# Obtained from @BotFather -> Payments. Leave empty when using Stars.
TELEGRAM_PROVIDER_TOKEN=""

# --- Pricing ----------------------------------------------------------------
# A product has ONE price, in RUB (kopecks, in the `amountMinor` column). What a
# buyer is charged is derived from it with these rates and then snapshotted onto
# the order, so changing a rate never rewrites an order that already exists.
#
# No external rate provider is contacted: these are configuration.

# Roubles per 1 USDT.
USDT_RUB_RATE="86"
# Kopecks per 1 Telegram Star (130 = 1.30 RUB). Kopecks because one Star is
# worth well under a rouble.
STAR_RUB_MINOR_RATE="130"

# --- On-chain payments (BEP20 USDT on BNB Smart Chain) -----------------------
# Off by default. Turning it on requires CRYPTO_DEPOSIT_XPUB.
CRYPTO_PAYMENTS_ENABLED="false"

# Watch-only extended PUBLIC key for the deposit account, e.g. the xpub of
# m/44'/60'/0'/0.
#
# PUBLIC material only. The API derives addresses from it and cannot spend.
# NEVER put an xprv or a mnemonic here — the process refuses to start if you do.
# The mnemonic belongs to the (later) sweep component alone, in its own
# EnvironmentFile with 0600 permissions, and never in git.
CRYPTO_DEPOSIT_XPUB=""

# Path the xpub above corresponds to. Recorded on each deposit wallet so a
# future sweep can re-derive the key for an address.
CRYPTO_DERIVATION_BASE_PATH="m/44'/60'/0'/0"

# BEP20 USDT contract on BSC mainnet. 18 decimals (not 6, unlike Tron/Ethereum).
USDT_CONTRACT_ADDRESS="0x55d398326f99059fF775485246999027B3197955"

# Two independent endpoints: every RPC call falls back to the second one.
BSC_RPC_URL="https://bsc-dataseed.binance.org"
BSC_RPC_FALLBACK_URL="https://bsc-rpc.publicnode.com"

# How long a buyer has to send funds.
CRYPTO_PAYMENT_TTL_MINUTES="60"

# Seconds between chain-watcher passes. 0 disables the watcher.
CRYPTO_MONITOR_INTERVAL_SECONDS="15"

# Largest block range per eth_getLogs call. Public endpoints reject wide ranges,
# and a rejected range is a range whose logs were never seen.
CRYPTO_SCAN_WINDOW_BLOCKS="2000"

# How far behind the head a brand-new address starts scanning. A buyer cannot
# have paid an address before it existed.
CRYPTO_SCAN_START_LAG_BLOCKS="200"

# Confirmation depth used ONLY when an RPC cannot answer the `finalized` tag.
# Not the primary mechanism: BSC has fast finality and finality is read from that
# tag. Deliberately deep, because "I cannot tell" should mean "wait", not "guess".
CRYPTO_FALLBACK_CONFIRMATIONS="45"

# Destination for swept funds. Sweeping is a later phase and is not implemented.
CRYPTO_TREASURY_ADDRESS=""

# --- Server -----------------------------------------------------------------
PORT="8080"
HOST="127.0.0.1"
NODE_ENV="development"
LOG_LEVEL="info"

# Comma-separated origins allowed to call the API.
# Include the Vite dev origin and your tunnel origin.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Max age of initData before it is rejected, in seconds.
INIT_DATA_MAX_AGE_SECONDS="86400"

# Comma-separated Telegram user ids that get admin rights.
ADMIN_TELEGRAM_IDS=""

# Dev only: when "true", the API accepts a fake unsigned viewer via the
# x-dev-telegram-id header so you can test in a normal browser.
# MUST stay false in production.
ALLOW_DEV_AUTH="true"
