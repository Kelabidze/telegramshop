# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# Local SQLite database (path is relative to apps/api).
DATABASE_URL="file:./prisma/dev.db"

# --- Telegram ---------------------------------------------------------------
# From @BotFather -> /newbot (or /token for an existing bot).
# This token is the signing key for initData. Treat it as a password.
TELEGRAM_BOT_TOKEN=""

# Secret for Telegram webhook verification. Any random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=""

# Public HTTPS origin of THIS api (used to register the webhook).
# With cloudflared this looks like https://something.trycloudflare.com
PUBLIC_API_URL=""

# --- Payments ---------------------------------------------------------------
# "stars"  -> Telegram Stars (XTR). No provider token needed.
# "none"   -> checkout creates orders but cannot charge (dev only).
PAYMENT_PROVIDER="stars"

# Only for real-money currencies via a payment provider (YooKassa, Stripe...).
# Obtained from @BotFather -> Payments. Leave empty when using Stars.
TELEGRAM_PROVIDER_TOKEN=""

# --- Server -----------------------------------------------------------------
PORT="8080"
HOST="127.0.0.1"
NODE_ENV="development"
LOG_LEVEL="info"

# Comma-separated origins allowed to call the API.
# Include the Vite dev origin and your tunnel origin.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Max age of initData before it is rejected, in seconds.
INIT_DATA_MAX_AGE_SECONDS="86400"

# Comma-separated Telegram user ids that get admin rights.
ADMIN_TELEGRAM_IDS=""

# Dev only: when "true", the API accepts a fake unsigned viewer via the
# x-dev-telegram-id header so you can test in a normal browser.
# MUST stay false in production.
ALLOW_DEV_AUTH="true"
