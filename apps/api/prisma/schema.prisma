// Prisma schema for the Telegram Mini App shop (digital goods).
//
// Local dev uses SQLite via a driver adapter. Moving to PostgreSQL later means
// changing `provider` to "postgresql", swapping the adapter in src/db.ts and
// regenerating migrations. The model layout is intentionally Postgres-safe:
// no SQLite-only types are used.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // The generated client is TypeScript. `tsc` compiles it to dist/ but does not
  // rewrite import specifiers, and Node's ESM loader requires explicit
  // extensions. Emitting ".js" specifiers keeps both `tsx` (dev) and the
  // compiled output (production) resolvable.
  importFileExtension = "js"
  moduleFormat        = "esm"
}

datasource db {
  provider = "sqlite"
}

/// A Telegram user who opened the Mini App.
model User {
  id           String   @id @default(cuid())
  /// Telegram user id. Stored as String because it can exceed 2^53.
  telegramId   String   @unique
  firstName    String
  lastName     String?
  username     String?
  languageCode String?
  /// Name the user picked inside the shop. Null = show the Telegram one.
  /// Kept apart from `firstName`, which every login overwrites from Telegram.
  displayName  String?
  isPremium    Boolean  @default(false)
  /// ADMIN | MANAGER | USER. Stored as String for SQLite/Postgres parity.
  role         String   @default("USER")
  /// Kept temporarily for compatibility with the current auth implementation.
  /// RBAC migrations will switch authorization checks to `role`.
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders             Order[]
  managerPermissions ManagerPermission[]

  @@index([createdAt])
  @@index([role])
}

/// One explicit permission granted to a manager.
/// Separate rows avoid SQLite-incompatible arrays and JSON permission blobs.
model ManagerPermission {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  createdAt  DateTime @default(now())

  @@unique([userId, permission])
  @@index([userId])
  @@index([permission])
}

model Category {
  id        String  @id @default(cuid())
  slug      String  @unique
  title     String
  emoji     String?
  sortOrder Int     @default(0)

  products Product[]

  @@index([sortOrder])
}

/// A country a variation is tied to, e.g. the jurisdiction of a KYC account.
/// Its own model rather than a string on Product: the storefront shows a country
/// carousel, and a free-form column would spell "Германия" three ways.
model Country {
  id        String  @id @default(cuid())
  slug      String  @unique
  title     String
  /// Flag emoji, shown in the carousel.
  emoji     String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
}

/// Fulfillment strategy for a digital product.
/// Kept as String + app-level enum so SQLite and Postgres behave identically.
///   LICENSE_KEY | FILE | LINK
///
/// Variations are modelled as child products (`parentId`), not as a separate
/// table. Everything downstream — LicenseKey stock, OrderLine snapshots, the
/// conditional UPDATE that makes overselling impossible, the club-tier price
/// maths — already works per Product, so a variation inherits all of it for
/// free. A dedicated Variation table would have needed its own stock, its own
/// order lines and its own copy of those invariants.
model Product {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  subtitle    String?
  description String  @default("")
  imageUrl    String?

  /// Card artwork: a single emoji, used when `imageUrl` is null.
  /// Either one or the other — the app prefers the image when both are set.
  emoji       String?

  /// Which storefront tab this belongs to: SHOP | ABUSE.
  /// A string like every other app-level enum here, for SQLite/Postgres parity.
  section     String  @default("SHOP")

  /// Club-tier price in RUB kopecks — the ONE base price of this product.
  ///
  /// Roubles are the unit of account. What a buyer actually pays (Telegram
  /// Stars, BEP20 USDT) is derived from this at checkout with the server's
  /// configured rate, and that derived amount plus the rate are snapshotted
  /// onto the order. Three independent price columns would need three people to
  /// remember to update them together.
  ///
  /// The column keeps its name because every read path already renders it
  /// through `formatMoney(amountMinor, currency)`; only the unit changed.
  amountMinor    Int
  /// Base currency of `amountMinor`. RUB for every product priced under the
  /// current model; the column survives so pre-existing XTR-priced rows are
  /// still readable and can be migrated deliberately.
  currency       String @default("RUB")
  /// Optional "was" price for discount display, same unit as `amountMinor`.
  compareAtMinor Int?

  fulfillmentKind String @default("LICENSE_KEY")

  /// Static payload for FILE / LINK products (URL or file id).
  staticPayload String?

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Set on a variation, null on a parent (or a plain standalone product).
  /// Cascade: deleting a parent removes its variations, which is the only sane
  /// reading — a variation has no meaning on its own.
  parentId String?
  parent   Product?  @relation("ProductVariations", fields: [parentId], references: [id], onDelete: Cascade)
  variations Product[] @relation("ProductVariations")

  /// Which country this variation is for. Null on parents and on products that
  /// simply have no country dimension.
  countryId String?
  country   Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)

  licenseKeys LicenseKey[]
  orderLines  OrderLine[]

  @@index([isActive, sortOrder])
  @@index([categoryId])
  /// The storefront query: active parents of one section, in display order.
  @@index([section, isActive, parentId, sortOrder])
  @@index([parentId])
  @@index([countryId])
}

/// One unit of sellable stock for LICENSE_KEY products.
/// Stock is rows, not a counter: claiming a key is a single conditional UPDATE,
/// which makes overselling impossible even under concurrent checkouts.
model LicenseKey {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// The secret handed to the buyer.
  secret    String
  claimedAt DateTime?
  createdAt DateTime @default(now())

  /// Set once the key is delivered. Unique so one key maps to one line.
  orderLineId String?    @unique
  orderLine   OrderLine? @relation(fields: [orderLineId], references: [id], onDelete: SetNull)

  /// Soft hold for a payment that is still in flight, with an expiry.
  ///
  /// Needed because an on-chain payment takes minutes rather than the seconds a
  /// Stars invoice takes, and a transfer is irreversible. Without a hold, a buyer
  /// could send funds and then be told the last key went to somebody who checked
  /// out afterwards — and there is no way to hand the money back.
  ///
  /// A timestamp rather than a boolean: a held key must return to stock on its own
  /// when the payment never arrives. Nothing anywhere has to remember to release
  /// it, which is the failure mode a boolean flag would have.
  ///
  /// This does NOT replace the conditional UPDATE in `claimLicenseKey` — a hold is
  /// advisory, and the claim is still what actually decides ownership.
  reservedUntil  DateTime?
  /// Which order line the hold is for, so its own claim can use the held key even
  /// though other checkouts cannot.
  reservedForLineId String?

  @@unique([productId, secret])
  @@index([productId, claimedAt])
  /// The reservation sweep and the availability count both filter on these.
  @@index([productId, claimedAt, reservedUntil])
  @@index([reservedForLineId])
}

/// PENDING | PAID | CANCELLED | REFUNDED | FAILED
model Order {
  id     String @id @default(cuid())
  /// Short code shown to the buyer, e.g. "A7F3C1".
  reference String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status           String @default("PENDING")
  /// What the buyer is charged in: XTR or USDT.
  currency         String
  /// Total in `currency`'s minor units — the amount actually charged.
  totalAmountMinor Int
  comment          String?

  /// Price snapshot: the same total in the base currency (RUB kopecks) and the
  /// rate used to derive `totalAmountMinor` from it.
  ///
  /// Snapshotted because rates are configuration. Changing USDT_RUB_RATE must
  /// never rewrite what an already-placed order asked for — a payment intent
  /// created yesterday has to stay payable at yesterday's number.
  ///
  /// Defaults exist for rows created before this column: `db push` backfills
  /// them, and a 1:1 rate is the honest reading of "we do not know".
  totalBaseRubMinor   Int @default(0)
  rateRubMinorPerUnit Int @default(1)
  /// Where the rate came from: RAPIRA | CONFIG | NONE.
  ///
  /// Recorded because "1990 ₽ at 94.78" is only half the story — a rate read from a
  /// live exchange and one read from a config file are different claims, and a
  /// dispute about a price months later needs to know which it was. NONE is for
  /// rails that convert nothing (roubles) or predate the column.
  rateSource String @default("NONE")
  /// Which side of the book, when the source was an exchange. ask | bid | null.
  rateSide   String?
  /// When the rate was fetched, as opposed to when the order was created. A gap
  /// between the two is the cache doing its job; a large gap would be a bug.
  rateFetchedAt DateTime?

  /// Opaque payload echoed back by Telegram in successful_payment.
  invoicePayload String  @unique
  invoiceUrl     String?

  /// Telegram payment identifiers, present after payment.
  telegramPaymentChargeId String? @unique
  providerPaymentChargeId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  lines OrderLine[]

  cryptoPayment  CryptoPaymentIntent?
  casheraPayment CasheraTransaction?

  @@index([userId, createdAt])
  @@index([status])
}

model OrderLine {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  /// Snapshots: the order must stay readable even if the product changes later.
  titleSnapshot   String
  /// Unit price in the ORDER's currency minor units — what was charged.
  unitAmountMinor Int
  quantity        Int    @default(1)
  totalAmountMinor Int
  /// The same unit price in the base currency (RUB kopecks) at checkout time.
  /// Keeps a line auditable after a rate change, and lets staff see the rouble
  /// value of a line that was charged in Stars.
  unitBaseRubMinor Int @default(0)
  fulfillmentKind String

  /// Secret delivered to the buyer (key, link). Null until paid.
  deliveredPayload String?

  licenseKeys LicenseKey[]

  @@index([orderId])
  @@index([productId])
}

/// A promo banner shown above the products of one storefront section.
///
/// Content lives in the database rather than in the bundle so a banner can be
/// swapped without a deploy. Deliberately dumb: an image, a caption and one
/// destination. Anything richer belongs in a product card.
model Banner {
  id        String  @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  /// Where a tap leads. Null = decorative, rendered as a non-interactive strip.
  /// Either an https URL or an in-app target like "category:gift-cards".
  linkUrl   String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  /// Which storefront screen shows it: SHOP | ABUSE. Same values as
  /// `Product.section`, so the two cannot drift into separate vocabularies.
  /// String like every other app-level enum here, for SQLite/Postgres parity.
  /// The default backfills rows created before sections existed, which all
  /// belonged to the main catalog.
  section   String  @default("SHOP")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The storefront read: active banners of one section, in display order.
  @@index([section, isActive, sortOrder])
}

/// Idempotency guard for Telegram webhook updates.
/// Telegram retries updates; processing one twice would deliver goods twice.
model ProcessedUpdate {
  updateId  String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Cashera (external gateway, RUB via a hosted page)
//
// The buyer pays on Cashera's page and the shop learns the outcome from a signed
// webhook. Two things follow from that, and they shape both models below:
//
//  1. A webhook's arrival is not proof of payment. The amount and currency are
//     checked against the order before anything ships.
//  2. Webhooks are retried, and can arrive concurrently. Deduplication is a
//     database constraint, not an in-memory set that a restart would forget.
// ---------------------------------------------------------------------------

/// One Cashera transaction, for one order.
///
/// pending | paid | failed | expired | refunded | chargeback
model CasheraTransaction {
  id String @id @default(cuid())

  /// One transaction per order. Unique because a second one would mean two live
  /// payment links for the same goods, and no correct way to decide which of them
  /// settles the order — or worse, a buyer paying both.
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// What we sent as `external_id`, and what the webhook echoes back.
  ///
  /// Unique so a retry after a lost response cannot produce a second transaction:
  /// Cashera is idempotent on this value, and so are we.
  externalId String @unique
  /// Cashera's own id. Unique: two rows claiming one gateway transaction would
  /// make reconciliation ambiguous.
  uuid       String @unique

  status      String @default("pending")
  /// RUB kopecks - the same unit the order holds and the gateway was sent.
  amountMinor Int
  currency    String @default("RUB")

  /// Which rail the buyer chose: `card` or `crypto`.
  ///
  /// Stored separately from `paymentMethod` because they answer different questions.
  /// This is what we asked for and stays fixed; `paymentMethod` is what Cashera
  /// actually settled with, which on a common payment form is unknown until the
  /// buyer picks. Defaulted so existing rows read as the card rail they were.
  rail String @default("card")

  /// The Cashera method code, e.g. `sbp` or `crypto`.
  ///
  /// Nullable: a common payment form returns `payment_method: null` with
  /// `selection_required: true` until the buyer chooses, and recording a guess would
  /// misreport how the money actually moved.
  paymentMethod String?

  /// What Cashera offered on a common payment form, as returned by the API.
  ///
  /// Diagnostics only - a record of what the buyer could choose from at the time.
  /// Never read back to build a picker: the list belongs to Cashera's page, and a
  /// copy of it here would go stale the moment merchant settings change.
  availableMethods String?

  /// Hosted page for the buyer. Not a secret: it is what they are redirected to.
  paymentUrl String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  events CasheraWebhookEvent[]

  @@index([status])
}

/// Webhook events already handled, keyed so a replay cannot act twice.
///
/// Keyed on (uuid, status) rather than on the uuid alone: a transaction legitimately
/// reports several statuses over its life (pending, then paid), and each is a
/// distinct event worth processing exactly once. Persisted rather than held in
/// memory because a restart must not reopen the window for a duplicate.
model CasheraWebhookEvent {
  id String @id @default(cuid())

  transactionUuid String
  status          String
  /// Nullable: an event can arrive for a transaction this shop has no row for
  /// (a stale merchant configuration, or a replay after cleanup). Recording it
  /// keeps the fact visible instead of dropping it silently.
  transactionId String?
  transaction   CasheraTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  receivedAt DateTime @default(now())

  /// The deduplication mechanism. A concurrent duplicate loses at the database,
  /// which is the only place that can arbitrate it.
  @@unique([transactionUuid, status])
  @@index([receivedAt])
}

// ---------------------------------------------------------------------------
// On-chain payments (BEP20 USDT on BNB Smart Chain)
//
// Layering, and the reason for it: the chain watcher only ever RECORDS what it
// saw (`CryptoTransaction`). It never touches an order. A single service
// (`services/crypto-payments.ts`) reads those records and decides the intent's
// status, and only then calls the existing `markOrderPaid`. Letting the watcher
// mark orders paid would put money decisions in the component most exposed to
// RPC lies, reorgs and duplicate logs.
// ---------------------------------------------------------------------------

/// A request to be paid a specific amount of USDT, at one address, by a deadline.
///
/// AWAITING | CONFIRMING | CONFIRMED | UNDERPAID | OVERPAID | EXPIRED | CANCELLED | FAILED
model CryptoPaymentIntent {
  id String @id @default(cuid())

  /// One live intent per order. Unique rather than a plain index: two intents
  /// for one order means two addresses and two expected amounts, and no correct
  /// way to decide which payment settles the order.
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  chain    String @default("BSC")
  chainId  Int    @default(56)
  asset    String @default("USDT")
  /// Token contract, snapshotted: a config change must not reinterpret amounts
  /// that were already quoted against a specific token.
  contract String
  decimals Int    @default(18)

  /// The exact expected amount, as a DECIMAL STRING of 18-decimal token units.
  ///
  /// A string, not Int/BigInt: 0.01 USDT is 10^16, past Number.MAX_SAFE_INTEGER,
  /// and Prisma's BigInt does not survive JSON. Every comparison parses to
  /// BigInt first.
  expectedAmountWei String
  /// The same amount in USDT cents, for accounting, sums and display.
  expectedAmountMinor Int

  /// Confirmed so far, same decimal-string convention. Recomputed from
  /// CryptoTransaction rows, never incremented in place — an increment that ran
  /// twice would inflate it, and a recompute cannot.
  receivedAmountWei String @default("0")

  status String @default("AWAITING")

  /// Blocks since inclusion of the newest matching transfer. Diagnostics and UI
  /// only: whether money is final is decided by the finalised block tag, not by
  /// counting to a magic number.
  confirmations Int @default(0)

  /// Recorded when the received amount exceeds the expected one, so an overpayment
  /// is a visible number for a human rather than a silently absorbed difference.
  overpaidAmountWei String?

  walletId String        @unique
  wallet   DepositWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expiresAt   DateTime
  confirmedAt DateTime?

  transactions CryptoTransaction[]

  /// The monitor's working set: open intents whose deadline has not passed.
  @@index([status, expiresAt])
}

/// A deposit address derived from the master key.
///
/// Holds NO secret material. Not the private key, not the mnemonic, not the seed
/// — only the public address and the path it was derived at, which is enough to
/// re-derive it when signing is genuinely needed (sweeping, a later phase). A
/// database dump therefore leaks no spending capability at all.
model DepositWallet {
  id      String @id @default(cuid())
  address String @unique

  /// BIP-44 child index. Unique so two intents can never share an address:
  /// one address per payment is what makes an incoming transfer attributable.
  derivationIndex Int    @unique
  /// Full path, stored rather than reconstructed, so a future change of account
  /// or coin type cannot orphan existing addresses.
  derivationPath  String

  /// Scan cursor: the highest block whose logs have been fully processed for
  /// this address. Advanced only after a range is handled, so a crash re-reads a
  /// range rather than skipping it.
  lastScannedBlock BigInt @default(0)

  /// NONE | PENDING | IN_PROGRESS | DONE | FAILED. Sweeping is a later phase;
  /// the state exists now so funds can be tracked from the first payment.
  sweepStatus String    @default("NONE")
  sweptAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  intent       CryptoPaymentIntent?
  transactions CryptoTransaction[]
  sweeps       SweepAttempt[]

  @@index([sweepStatus])
}

/// One observed BEP20 Transfer into a deposit address.
///
/// This table is the deduplication mechanism. `@@unique([txHash, logIndex])` is
/// a database constraint, so a duplicate insert fails no matter how many scans
/// run concurrently. Checking for existence before inserting would leave the
/// classic read-then-write race, which is exactly how a double credit happens.
model CryptoTransaction {
  id String @id @default(cuid())

  txHash String
  /// Required, and the reason the unique key is a pair: one transaction can carry
  /// several Transfer logs to the same address, and they are separate payments.
  logIndex Int

  walletId String        
  wallet   DepositWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  /// Nullable on purpose: money can arrive at an address whose intent already
  /// expired, or was never created. Recording it with no intent keeps the funds
  /// visible instead of dropping the log on the floor.
  intentId String?
  intent   CryptoPaymentIntent? @relation(fields: [intentId], references: [id], onDelete: SetNull)

  fromAddress String
  /// Decimal string of 18-decimal token units, as on the intent.
  amountWei   String

  blockNumber BigInt
  /// Kept so a reorg is detectable: if the canonical block at this height no
  /// longer has this hash, the transfer never happened on the surviving chain.
  blockHash   String

  confirmations Int    @default(0)
  /// SEEN | CONFIRMED | ORPHANED
  status        String @default("SEEN")

  firstSeenAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?

  @@unique([txHash, logIndex])
  @@index([walletId, blockNumber])
  @@index([intentId, status])
  @@index([status])
}

/// An attempt to move confirmed funds from a deposit address to the treasury.
///
/// Schema only for now: signing, gas funding and the transfer itself are a
/// deliberate later phase. It exists already so that the first payments are
/// trackable — and because sweeping must never be in the fulfilment path, the
/// buyer gets their goods whether or not this table has a row.
model SweepAttempt {
  id String @id @default(cuid())

  walletId String
  wallet   DepositWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  /// Amount this attempt tried to move, decimal string of token units.
  amountWei String
  /// The sweep transaction, once broadcast. Unique so one broadcast is one row.
  txHash    String? @unique
  /// PENDING | SENT | CONFIRMED | FAILED
  status    String  @default("PENDING")
  /// 1-based counter, so repeated failures are visible rather than overwritten.
  attempt   Int     @default(1)
  /// Failure reason, for diagnosis. Never a key or any secret material.
  error     String?
  /// A deposit address holds no BNB, so gas has to be sent first; that transfer
  /// is recorded here to make a half-finished sweep diagnosable.
  gasFundingTxHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletId, status])
}
