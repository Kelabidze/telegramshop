# Copy to `.env` for local development.

# Absolute API origin. Leave empty to use the Vite dev proxy (recommended:
# same-origin means no CORS and a single tunnel serves both app and API).
VITE_API_URL=""

# Where the dev proxy forwards /api. Must match the API's HOST:PORT.
VITE_API_PROXY_TARGET="http://127.0.0.1:8080"

# Lets you use the app in a normal browser without Telegram.
# Requires ALLOW_DEV_AUTH=true on the API. Use any number as your fake user id.
VITE_DEV_TELEGRAM_ID="999000999"

# Public link to the club channel. Empty hides every "join the channel" entry
# point instead of opening a dead link. Must point at the same channel the API
# verifies membership against (CLUB_CHANNEL_ID).
VITE_CLUB_CHANNEL_URL=""
